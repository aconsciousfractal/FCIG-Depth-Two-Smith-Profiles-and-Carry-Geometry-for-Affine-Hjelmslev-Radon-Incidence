# Normalize shipped text so integrity hashes are cross-platform.
*.py    text eol=lf
*.md    text eol=lf
*.tex   text eol=lf
*.bib   text eol=lf
*.cff   text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
paper/latexmkrc text eol=lf
requirements.lock text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.pdf   binary
